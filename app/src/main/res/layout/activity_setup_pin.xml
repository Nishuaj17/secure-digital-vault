<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_cream">

    <!-- Decorative circle, top-right -->
    <View
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/circle_mint"
        android:alpha="0.85"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="-15dp" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create your vault PIN"
        android:textColor="@color/vault_charcoal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="72dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="This PIN protects everything in your vault. Choose 6 digits you'll remember — there is no way to recover a forgotten PIN."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card holding the PIN input -->
    <androidx.cardview.widget.CardView
        android:id="@+id/pinCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/vault_white"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/vault_border"
        android:layout_marginTop="32dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/stageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter PIN"
                android:textColor="@color/vault_indigo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:textSize="22sp"
                android:textColor="@color/vault_charcoal"
                android:background="@android:color/transparent"
                android:hint="••••••"
                android:importantForAutofill="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/vault_indigo"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/vault_coral"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/continueButton"
        style="@style/VaultButton.Primary"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="Continue"
        android:layout_marginTop="28dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/pinCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/stepIndicatorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 1 of 2"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/continueButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
 
