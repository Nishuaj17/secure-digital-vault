<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_indigo">

    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/circle_mustard"
        android:alpha="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-25dp"
        android:layout_marginEnd="-20dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/lockIconCard"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="@color/vault_mustard"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@color/vault_charcoal" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome back"
        android:textColor="@color/vault_cream"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/lockIconCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/pinCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/vault_white"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/vault_mustard"
        android:layout_marginTop="28dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your PIN"
                android:textColor="@color/vault_indigo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/pinInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:gravity="center"
                android:letterSpacing="0.5"
                android:textSize="22sp"
                android:textColor="@color/vault_charcoal"
                android:background="@android:color/transparent"
                android:hint="••••••"
                android:importantForAutofill="no" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/vault_indigo"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/vault_coral"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/unlockButton"
        style="@style/VaultButton.Primary"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="Unlock"
        android:layout_marginTop="20dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/pinCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/biometricButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_mint"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="@color/vault_charcoal"
        android:contentDescription="Unlock with biometrics"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/unlockButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
 
