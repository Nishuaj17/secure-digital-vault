<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_cream">

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vault_indigo"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_mustard"
            android:alpha="0.85"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="-15dp"
            android:layout_marginEnd="-10dp" />

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/vault_cream"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lockButton" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Vault unlocked and secure"
            android:textColor="#B8B6C8"
            android:textSize="12sp"
            android:layout_marginTop="3dp"
            app:layout_constraintTop_toBottomOf="@id/appNameText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lockButton" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_coral"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/vault_charcoal"
            android:contentDescription="Search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settingsButton"
            android:layout_marginEnd="10dp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_mint"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/vault_charcoal"
            android:contentDescription="Settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/lockButton"
            android:layout_marginEnd="10dp" />

        <ImageButton
            android:id="@+id/lockButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_mustard"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@color/vault_charcoal"
            android:contentDescription="Lock vault"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Category grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/quickActionsScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Quick actions -->
    <HorizontalScrollView
        android:id="@+id/quickActionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addPasswordButton"
                style="@style/VaultButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Password"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/addNoteButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Note"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/addDocumentButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Document"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/addCardButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Card"
                android:textSize="13sp" />


            <Button
                android:id="@+id/addRecoveryButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Recovery Code"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/addPhotoButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ Private Photo"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <Button
                android:id="@+id/addPdfButton"
                style="@style/VaultButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="+ PDF"
                android:textSize="13sp" />


        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
 
