<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vault_indigo">

    <!-- Decorative floating circles -->
    <View
        android:id="@+id/circleMustard"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/circle_mustard"
        android:alpha="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="-20dp" />

    <View
        android:id="@+id/circleCoral"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/circle_coral"
        android:alpha="0.85"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="60dp"
        android:layout_marginStart="30dp" />

    <View
        android:id="@+id/circleMint"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/circle_mint"
        android:alpha="0.9"
        app:layout_constraintBottom_toTopOf="@id/circleCoral"
        app:layout_constraintStart_toEndOf="@id/circleCoral"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp" />

    <!-- Lock icon badge in the center -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoCard"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/vault_mustard"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/appNameText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_lock_lock"
            app:tint="@color/vault_charcoal" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/appNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/vault_cream"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintBottom_toTopOf="@id/taglineText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/taglineText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_tagline"
        android:textColor="#B8B6C8"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/appNameText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:indeterminateTint="@color/vault_mustard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
 
