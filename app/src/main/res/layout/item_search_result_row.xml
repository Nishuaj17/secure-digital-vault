<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/vault_white"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/vault_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/iconBackground"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_mint"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/resultIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                app:tint="@color/vault_charcoal" />

        </FrameLayout>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Result title"
            android:textColor="@color/vault_charcoal"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/iconBackground"
            app:layout_constraintStart_toEndOf="@id/iconBackground"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/resultType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/resultTitle"
            app:layout_constraintStart_toEndOf="@id/iconBackground" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
 
