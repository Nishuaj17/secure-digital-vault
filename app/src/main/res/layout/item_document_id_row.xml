<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/vault_white"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/vault_border">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/rowIconBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_mint"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_id"
                app:tint="@color/vault_charcoal" />

        </FrameLayout>

        <TextView
            android:id="@+id/rowName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Document name"
            android:textColor="@color/vault_charcoal"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/rowIconBackground"
            app:layout_constraintStart_toEndOf="@id/rowIconBackground"
            app:layout_constraintEnd_toStartOf="@id/favoriteButton" />

        <TextView
            android:id="@+id/rowType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Document type"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/rowName"
            app:layout_constraintStart_toEndOf="@id/rowIconBackground"
            app:layout_constraintEnd_toStartOf="@id/favoriteButton" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/star_off"
            app:tint="@color/vault_mustard"
            android:contentDescription="Toggle favorite"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/deleteButton" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_coral"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/vault_charcoal"
            android:contentDescription="Delete document"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
 
