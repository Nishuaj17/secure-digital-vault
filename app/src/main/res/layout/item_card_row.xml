<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/vault_indigo"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/rowNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Card nickname"
            android:textColor="@color/vault_cream"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/favoriteButton" />

        <TextView
            android:id="@+id/rowCardType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Visa"
            android:textColor="#B8B6C8"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/rowNickname"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/star_off"
            app:tint="@color/vault_mustard"
            android:contentDescription="Toggle favorite"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/deleteButton"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_coral"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/vault_charcoal"
            android:contentDescription="Delete card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/rowNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•••• •••• •••• 1234"
            android:textColor="@color/vault_cream"
            android:textSize="18sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/rowCardType"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/showDetailsButton"
            style="@style/VaultButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Show Details"
            android:textSize="11sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:minWidth="0dp"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/rowNumber"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
 
