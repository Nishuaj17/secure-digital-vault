<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardBackgroundColor="@color/vault_white"
    app:cardElevation="0dp"
    app:strokeWidth="2dp"
    app:strokeColor="@color/vault_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/iconBackground"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_mustard"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/categoryIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                app:tint="@color/vault_charcoal"
                tools:src="@drawable/ic_password"
                xmlns:tools="http://schemas.android.com/tools" />

        </FrameLayout>

        <TextView
            android:id="@+id/categoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passwords"
            android:textColor="@color/vault_charcoal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/categoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
 
